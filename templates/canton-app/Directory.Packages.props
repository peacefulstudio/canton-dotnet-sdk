<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Daml.Codegen.CSharp.MSBuild" Version="@SdkVersion@" />
    <PackageVersion Include="Daml.Runtime" Version="@SdkVersion@" />

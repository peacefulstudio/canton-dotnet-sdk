<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="IncludeSymbols">

  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Canton.ProjectTemplates</PackageId>
    <PackageType>Template</PackageType>
    <Description>dotnet new templates for the Canton .NET SDK. Installs the canton-app template: a Daml contract, its generated C# bindings and a console app that creates the contract on a LocalNet participant and reads it back.</Description>
    <PackageTags>canton;daml;dotnet-new;templates;smart-contracts</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnablePackageValidation>false</EnablePackageValidation>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <CantonAppTemplateDirectory>$(MSBuildThisFileDirectory)..\..\templates\canton-app\</CantonAppTemplateDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <CantonAppTemplateFile Include="$(CantonAppTemplateDirectory)**\*" Exclude="$(CantonAppTemplateDirectory)Directory.Packages.props;$(CantonAppTemplateDirectory)**\bin\**;$(CantonAppTemplateDirectory)**\obj\**;$(CantonAppTemplateDirectory)daml\.daml\**" />
  </ItemGroup>

  <Target Name="StampTemplateWithPackedSdkVersion" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <StampedTemplateDirectory>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)canton-app/', '$(MSBuildProjectDirectory)/'))</StampedTemplateDirectory>
      <StampedPackagesProps>$(StampedTemplateDirectory)Directory.Packages.props</StampedPackagesProps>
      <PackagesPropsWithVersion>$([System.IO.File]::ReadAllText('$(CantonAppTemplateDirectory)Directory.Packages.props').Replace('@SdkVersion@', '$(PackageVersion)'))</PackagesPropsWithVersion>
    </PropertyGroup>
    <WriteLinesToFile File="$(StampedPackagesProps)" Lines="$(PackagesPropsWithVersion)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Include="@(CantonAppTemplateFile)" Pack="true" PackagePath="content/canton-app/%(RecursiveDir)%(Filename)%(Extension)" />
      <Content Include="$(StampedPackagesProps)" Pack="true" PackagePath="content/canton-app/Directory.Packages.props" />
    </ItemGroup>
  </Target>

</Project>

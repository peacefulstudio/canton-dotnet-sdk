<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Daml.Ledger.Abstractions</PackageId>
    <Description>Transport-agnostic abstractions for Daml ledger clients. Defines ILedgerClient, the contract any Daml ledger transport (gRPC Canton, HTTP REST, in-memory test fake) implements.</Description>
    <PackageTags>daml;canton;blockchain;smart-contracts;ledger;abstractions</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Canton.Ledger.Abstractions" />
    <InternalsVisibleTo Include="Canton.Ledger.Kernel" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daml.Runtime\Daml.Runtime.csproj" />
  </ItemGroup>

</Project>

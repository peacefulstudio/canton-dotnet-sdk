<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Canton.Ledger.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for the Canton Ledger API clients. AddCantonLedgerProblemDetails() answers a LedgerOperationException escaping a minimal-API or MVC endpoint with an RFC 9457 problem+json response: 409 for contention or a consumed contract, 404 for a missing resource, and 202 carrying commandId and updateId for a command that committed whose result could not be read, which the caller must not retry. UseCantonLedgerProblemDetails() does the same as middleware for a host with its own catch-all exception handling, rethrowing every other exception. ProducesLedgerProblems() declares those responses in the OpenAPI document. Depends on Canton.Ledger.Abstractions only, so it works with either transport.</Description>
    <PackageTags>canton;daml;aspnetcore;problem-details;openapi;client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Canton.Ledger.AspNetCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Canton.Ledger.Abstractions\Canton.Ledger.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

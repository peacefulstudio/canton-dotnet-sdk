<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Daml.Ledger.Abstractions.Testing.Conformance</PackageId>
    <Description>Behavioral conformance kit for Daml.Ledger.Abstractions: an abstract xUnit base any ILedgerClient implementation subclasses to verify the documented behavioral contract (cancellation, unclassified-row surfacing, terminal checkpoint, seeded-row ordering).</Description>
    <PackageTags>daml;canton;blockchain;smart-contracts;ledger;abstractions;conformance;testing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daml.Ledger.Abstractions\Daml.Ledger.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

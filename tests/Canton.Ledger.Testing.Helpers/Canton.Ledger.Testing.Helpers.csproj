<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <!-- NuGet raises NU1510 when every target prunes the reference; with the single net11.0 target of
         GitHub Actions builds the net11.0 pruning covers it, while net10.0 still needs the package. -->
    <NoWarn>$(NoWarn);CA1707;CA2255;NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Canton.Ledger.Grpc.Client.Tests" />
    <InternalsVisibleTo Include="Canton.Ledger.Grpc.Client.Integration.Tests" />
    <InternalsVisibleTo Include="Canton.Ledger.Rest.Client.Tests" />
    <InternalsVisibleTo Include="Canton.Ledger.Rest.Client.Integration.Tests" />
    <InternalsVisibleTo Include="Canton.Ledger.Client.Parity.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Remove="xunit.v3.mtp-v2" />
    <PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Remove="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Daml.Runtime\Daml.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Canton.Ledger.Abstractions\Canton.Ledger.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Daml.Codegen.Testing.Conformance\Daml.Codegen.Testing.Conformance.csproj" />
  </ItemGroup>

</Project>

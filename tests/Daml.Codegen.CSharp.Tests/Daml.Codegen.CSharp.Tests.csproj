<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Roslyn\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Daml.Codegen.CSharp\Daml.Codegen.CSharp.csproj" />
    <ProjectReference Include="..\..\src\Daml.Codegen.CSharp.Cli\Daml.Codegen.CSharp.Cli.csproj" />
    <ProjectReference Include="..\..\src\Daml.Runtime\Daml.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Daml.Ledger.Abstractions\Daml.Ledger.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Snapshot fixtures for drift-detection tests. The DAR + expected/ tree are
      copied alongside the test assembly so the test does not depend on the
      repo source layout at runtime. The .cs files under Snapshots/ are
      generated codegen output to compare against, NOT source — exclude them
      from the test assembly's Compile item set. Refresh procedure: see
      Snapshots/splice-api-token-holding-v1/README.md.
    -->
    <Compile Remove="Snapshots\**\*.cs" />
    <None Remove="Snapshots\**\*" />
    <Content Include="Snapshots\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Daml.Codegen.Testing.Conformance\Generated\RichTypes\*.cs" Link="Snapshots\richtypes\expected\RichTypes\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Daml.Codegen.Testing.Conformance\Generated\SubmitShapes\*.cs" Link="Snapshots\richtypes\expected\SubmitShapes\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Daml.Codegen.Testing.Conformance\Generated\ContractKeys\*.cs" Link="Snapshots\contractkeys\expected\ContractKeys\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Daml.Codegen.Testing.Conformance\Generated\Disclosure\*.cs" Link="Snapshots\contractkeys\expected\Disclosure\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Daml.Codegen.Testing.Conformance\Generated\KeyBuilders\*.cs" Link="Snapshots\contractkeys\expected\KeyBuilders\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Daml.Codegen.Testing.Conformance\Generated\DefaultTarget\*.cs" Link="Snapshots\defaulttarget\expected\DefaultTarget\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      The Quickstart sample's vendored intermediate.binpb (refreshed by
      the quickstart entry of scripts/regenerate.sh) is copied alongside the test assembly so the
      DamlPrimitiveCatalog corpus-freedom test can enumerate every shipped
      intermediate.binpb — the 12 snapshot families plus this one — without depending on
      the repo source layout at runtime.
    -->
    <Content Include="QuickstartSample\intermediate.binpb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>

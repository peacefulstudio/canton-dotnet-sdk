<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <TestTargetFrameworks>net10.0;net11.0</TestTargetFrameworks>
    <TestTargetFrameworks Condition="'$(GITHUB_ACTIONS)' == 'true' And '$(SDK_TEST_ALL_TARGET_FRAMEWORKS)' != 'true'">net11.0</TestTargetFrameworks>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RollForward>Major</RollForward>
    <UseAppHost>true</UseAppHost>
    <!-- Test assemblies publish no API, so they opt out of the repo-wide
         documentation file rather than suppressing CS1591 over it. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Residual analyzer suppressions, scoped to test projects only.
         CA1707 — test method names follow the repo-wide Subject_scenario_expectation
                  convention; the underscores are the convention.
         CA1822 — xUnit fixture and builder members are reached through the injected
                  fixture instance, so marking them static would break the call sites
                  that make the fixture idiom work. -->
    <NoWarn>$(NoWarn);CA1707;CA1822</NoWarn>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformCommandLineArguments>--coverage --coverage-output-format cobertura --coverage-output $(MSBuildProjectName).cobertura.xml --coverage-settings $(MSBuildThisFileDirectory)../coverage.settings.xml --hangdump --hangdump-timeout 20m --hangdump-type Mini</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseMicrosoftTestingPlatformRunner)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared\TestNamingConventionTests.cs" Link="Shared\TestNamingConventionTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="CantonVersion" Value="$(CantonVersion)" />
  </ItemGroup>
</Project>

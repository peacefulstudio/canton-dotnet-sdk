<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1062;CA1852;CA1859</NoWarn>

    <!-- Packaging rigor. Pack-time only, so inert for IsPackable=false projects. SourceLink for
         GitHub is implicit in the .NET SDK; ContinuousIntegrationBuild=true is passed by
         publish.yaml, never locally. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <EnablePackageValidation Condition="$(MSBuildProjectName.StartsWith('Canton.Ledger.')) Or $([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^Daml\.(Runtime|Runtime\.Grpc|Ledger\.Abstractions|Ledger\.Abstractions\.Testing\.Conformance|Codegen\.CSharp|Codegen\.Intermediate|Codegen\.Testing\.Conformance)$'))">true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.6.0-preview.3</PackageValidationBaselineVersion>

    <!-- Package metadata -->
    <Authors>Peaceful Studio OÜ</Authors>
    <Company>Peaceful Studio OÜ</Company>
    <Copyright>Copyright 2026 Peaceful Studio OÜ</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/peacefulstudio/canton-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/peacefulstudio/canton-dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>

    <CantonVersion>3.5.19</CantonVersion>

    <Version>0.6.0-preview.4</Version>
    <VersionReleasePrefix>$(Version)</VersionReleasePrefix>
    <VersionReleasePrefix Condition="$(VersionReleasePrefix.Contains('-'))">$(VersionReleasePrefix.Substring(0, $(VersionReleasePrefix.IndexOf('-'))))</VersionReleasePrefix>
    <VersionReleasePrefix Condition="$(VersionReleasePrefix.Contains('+'))">$(VersionReleasePrefix.Substring(0, $(VersionReleasePrefix.IndexOf('+'))))</VersionReleasePrefix>
    <AssemblyVersion>$(VersionReleasePrefix).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>

    <!-- Package output directory -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)output/nuget</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
